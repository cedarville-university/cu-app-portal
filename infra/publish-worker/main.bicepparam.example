using './main.bicep'
param namePrefix = 'cu-launch'
param environmentId = '/subscriptions/<subscription>/resourceGroups/rg-cu-app-portal/providers/Microsoft.App/managedEnvironments/<existing-import-environment>'
param acrLoginServer = '<existing-worker-registry>.azurecr.io'
param pullIdentityId = '/subscriptions/<subscription>/resourceGroups/rg-cu-app-portal/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<existing-pull-identity>'
param serviceBusNamespaceName = '<existing-service-bus-namespace>'
param keyVaultName = '<existing-worker-vault>'
param portalPrincipalId = '<portal-managed-identity-object-id>'
param deploymentPrincipalId = '<github-actions-service-principal-object-id>'
param imageDigest = 'sha256:<64-hex-image-digest>'
param workerEnvironment = {
  GITHUB_APP_ID: '<app-id>'
  GITHUB_ALLOWED_ORGS: 'cu-app-portal-repos'
  GITHUB_DEFAULT_ORG: 'cu-app-portal-repos'
  GITHUB_DEFAULT_REPO_VISIBILITY: 'private'
  GITHUB_APP_INSTALLATIONS_JSON: '{"cu-app-portal-repos":"<installation-id>"}'
  AZURE_PUBLISH_RESOURCE_GROUP: 'rg-cu-app-portal'
  AZURE_PUBLISH_APP_SERVICE_PLAN: '<shared-plan>'
  AZURE_PUBLISH_POSTGRES_SERVER: '<shared-postgres-server>'
  AZURE_PUBLISH_POSTGRES_ADMIN_USER: '<postgres-admin-user>'
  AZURE_PUBLISH_LOCATION: '<azure-region>'
  AZURE_PUBLISH_RUNTIME_STACK: 'NODE|24-lts'
  AZURE_PUBLISH_TENANT_ID: '<tenant-id>'
  AZURE_PUBLISH_SUBSCRIPTION_ID: '<subscription-id>'
  AZURE_PUBLISH_ENTRA_CLIENT_ID: '<shared-app-registration-client-id>'
  AZURE_PUBLISH_ENTRA_ISSUER: 'https://login.microsoftonline.com/<tenant-id>/v2.0'
  AZURE_PUBLISH_ENTRA_APP_OBJECT_ID: '<shared-app-registration-object-id>'
  PORTAL_APP_URL: 'https://launch.cedarville.edu'
  SMTP_HOST: '<smtp-host>'
  SMTP_PORT: '587'
  SMTP_TLS_MODE: 'starttls'
  SMTP_USERNAME: '<smtp-user>'
  SMTP_FROM: '<portal-from-address>'
  SMTP_REPLY_TO: '<portal-support-address>'
}
